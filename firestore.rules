rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /tp2_publicProducts/{id} {
      allow read: if resource.data.published == true || admin();
      allow write: if false;
    }
    match /{collection}/{id} {
      allow read: if admin() && collection in ['temo','tp2_products','tp2_customers','tp2_orders','tp2_purchases','tp2_expenses','tp2_cash','tp2_movements','tp2_supplies','tp2_shipments','tp2_audit','tp2_legacy'];
      // Validated server commands use Admin SDK; web clients cannot bypass invariants.
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
